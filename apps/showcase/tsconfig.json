{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"noEmit": true,
		"incremental": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"plugins": [
			{
				"name": "next"
			}
		],
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@fleect/exhuma": ["../../packages/core/src/index.ts"],
			"@fleect/exhuma/*": ["../../packages/core/src/*"],
			"@fleect/exhuma-cards": ["../../packages/cards/src/index.ts"],
			"@fleect/exhuma-cards/*": ["../../packages/cards/src/*"],
			"@fleect/exhuma-layouts": ["../../packages/layouts/src/index.ts"],
			"@fleect/exhuma-layouts/*": ["../../packages/layouts/src/*"],
			"@fleect/exhuma-router": ["../../packages/router/src/index.ts"],
			"@fleect/exhuma-router/*": ["../../packages/router/src/*"],
			"@fleect/exhuma-registry": ["../../packages/registry/src/index.ts"],
			"@fleect/exhuma-registry/*": ["../../packages/registry/src/*"],
			"@fleect/exhuma-registry/schema": ["../../packages/registry/dist/schema.d.ts"]
		},
		"jsx": "preserve"
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../../packages/*/src/**/*.d.ts"],
	"exclude": ["node_modules"]
}
