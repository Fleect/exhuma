{
	"name": "exhuma-monorepo",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Exhuma — Unified developer monorepo for tactile interactions, layout engines, and routing architecture",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"tooling:check": "node .ai/tools/check.mjs",
		"config:check": "node --import tsx tooling/config/check-config.ts",
		"arch:check": "node --import tsx tooling/architecture/check-architecture.ts",
		"docs:check": "node --import tsx tooling/docs/check-links.ts",
		"scaffold:component": "node --import tsx tooling/scaffold/scaffold-component.ts",
		"build:registry": "node --import tsx tooling/registry/build-registry.ts",
		"build:libs": "pnpm --filter './packages/**' build",
		"build": "pnpm run build:registry && pnpm run build:libs && pnpm --filter showcase build",
		"dev": "pnpm run build:libs && pnpm --filter showcase dev",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "pnpm -r test:coverage",
		"lint": "eslint packages/*/src",
		"lint:fix": "eslint --fix packages/*/src",
		"format": "prettier --write \"packages/**/*.{ts,tsx,json,md}\" \"apps/**/*.{ts,tsx,json,md}\" \"*.{json,md,yaml,js,mjs}\"",
		"format:check": "prettier --check \"packages/**/*.{ts,tsx,json,md}\" \"apps/**/*.{ts,tsx,json,md}\" \"*.{json,md,yaml,js,mjs}\"",
		"format:all": "pnpm run format && pnpm run lint:fix",
		"typecheck": "pnpm run type:check",
		"type:check": "pnpm -r exec tsc --noEmit",
		"check:all": "pnpm tooling:check && pnpm config:check && pnpm arch:check && pnpm docs:check && pnpm typecheck",
		"sync": "node .formatter/sync.cjs"
	},
	"devDependencies": {
		"@exhuma/registry": "workspace:*",
		"@types/node": "^22.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": "^9.0.0",
		"eslint-config-next": "^16.3.5",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-better-tailwindcss": "^4.7.0",
		"eslint-plugin-prettier": "^5.2.0",
		"eslint-plugin-react": "^7.37.0",
		"eslint-plugin-react-hooks": "^5.1.0",
		"eslint-plugin-unicorn": "^74.0.0",
		"prettier": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tsup": "^8.5.1",
		"tsx": "^4.19.2",
		"turbo": "^2.4.4",
		"typescript": "^5.7.0",
		"vitest": "^5.0.0"
	}
}
