{
	"name": "@exhuma/registry",
	"version": "0.1.0",
	"description": "Canonical Universal Component Registry and 13-ecosystem code generation engine for Exhuma",
	"license": "MIT",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.cjs"
			}
		},
		"./schema": {
			"import": {
				"types": "./dist/schema.d.mts",
				"default": "./dist/schema.mjs"
			},
			"require": {
				"types": "./dist/schema.d.ts",
				"default": "./dist/schema.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"type:check": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.7.0"
	}
}
